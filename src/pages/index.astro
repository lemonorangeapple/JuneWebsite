---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from 'astro-icon/components';
import Card from "../components/Card.astro";
---

<BaseLayout title="June_qwq" description="June_qwq 的个人博客，记录全栈开发、基础运维与信奥学习笔记。">
    <Card variant="filled">
        <div class="flex flex-col items-center gap-3 text-center">
            <img
                src="https://dl.imjcj.eu.org/avatar.xmini.jpg"
                width="64"
                height="64"
                id="avatar"
                alt="June_qwq 的头像"
            />
            <h1 class="mt-2 text-headline-large text-on-surface sm:text-display-small">June_qwq</h1>
            <code class="m3-code-chip">(self || self = new Self())</code>
            <p class="text-body-large text-on-surface-variant">熟悉全栈开发、基础运维、C++数据结构、Qt开发等</p>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
            <a class="m3-button m3-button--filled" href="https://github.com/lemonorangeapple"><Icon name="mdi:github" aria-hidden="true" />Github</a>
            <a class="m3-button m3-button--tonal" href="https://space.bilibili.com/1036201235"><Icon name="mingcute:bilibili-line" aria-hidden="true" />Bilibili</a>
        </div>
        <script is:inline>
            const box = document.getElementById("avatar");

            if (box && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                let currentAngle = 0;
                const baseSpeed = 0.7;
                const acceleration = -0.02;
                const deceleration = 0.05;
                let currentSpeed = baseSpeed;
                let isHovering = false;
                let animationId = 0;

                function animate() {
                    currentSpeed = isHovering
                        ? currentSpeed + acceleration
                        : Math.max(currentSpeed - deceleration, baseSpeed);
                    currentAngle = (currentAngle + currentSpeed) % 360;
                    box.style.transform = `rotate(${currentAngle}deg)`;
                    animationId = requestAnimationFrame(animate);
                }

                box.addEventListener("mouseenter", () => {
                    isHovering = true;
                });
                box.addEventListener("mouseleave", () => {
                    isHovering = false;
                });
                window.addEventListener("pagehide", () => cancelAnimationFrame(animationId), { once: true });
                animate();
            }
        </script>
    </Card>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <a class="m3-card m3-card--elevated m3-card--interactive m3-destination" href="/posts"><Icon name="material-symbols:article-outline-rounded" aria-hidden="true" />文章总览</a>
        <a class="m3-card m3-card--elevated m3-card--interactive m3-destination" href="/posts/tags"><Icon name="material-symbols:label-outline-rounded" aria-hidden="true" />文章标签</a>
        <a class="m3-card m3-card--elevated m3-card--interactive m3-destination" href="/posts/topic"><Icon name="material-symbols:collections-bookmark-outline-rounded" aria-hidden="true" />文章专栏</a>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a class="m3-card m3-card--outlined m3-card--interactive m3-destination" href="https://dl.imjcj.eu.org/"><Icon name="material-symbols:folder-outline-rounded" aria-hidden="true" />文件下载</a>
        <a class="m3-card m3-card--outlined m3-card--interactive m3-destination" href="https://random.imjcj.eu.org/"><Icon name="material-symbols:person-outline-rounded" aria-hidden="true" />学号抽选</a>
        <a class="m3-card m3-card--outlined m3-card--interactive m3-destination" href="https://cd.imjcj.eu.org/"><Icon name="material-symbols:calendar-today-outline-rounded" aria-hidden="true" />节日计时</a>
        <a class="m3-card m3-card--outlined m3-card--interactive m3-destination" href="https://up.imjcj.eu.org/share/3ePj6A55BwW8hpId"><Icon name="material-symbols:monitoring-rounded" aria-hidden="true" />统计观察</a>
    </div>
</BaseLayout>
