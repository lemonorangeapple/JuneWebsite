---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from 'astro-icon/components';
import SearchModal from "../../components/SearchModal.astro";
import PostCard from "../../components/PostCard.astro";
import { posts } from "../../data/posts";
---

<BaseLayout title="文章总览" description="June_qwq 博客的全部文章列表。">
    <header class="flex flex-col gap-4">
        <h1 class="text-headline-medium text-on-surface sm:text-headline-large">文章总览</h1>
        <button id="search-trigger" type="button" class="m3-search-bar" aria-haspopup="dialog">
            <Icon name="material-symbols:search-rounded" aria-hidden="true" />
            <span>搜索文章</span>
        </button>
        <div class="flex flex-wrap gap-3">
            <a class="m3-button m3-button--tonal" href="/posts/tags"><Icon name="material-symbols:label-outline-rounded" aria-hidden="true" />文章标签</a>
            <a class="m3-button m3-button--tonal" href="/posts/topic"><Icon name="material-symbols:collections-bookmark-outline-rounded" aria-hidden="true" />文章专栏</a>
        </div>
    </header>
    <SearchModal />
    <div class="m3-post-grid">
        {posts.map((post) => <PostCard post={post} showTopic />)}
    </div>
</BaseLayout>
