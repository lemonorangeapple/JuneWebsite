---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { Icon } from 'astro-icon/components';
import { posts } from "../../data/posts";

const topics = [...new Set(posts.map((post) => post.topic).filter(Boolean))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="文章专栏" description="按专栏浏览 June_qwq 的文章。">
    <header class="flex flex-col gap-4">
        <h1 class="text-headline-medium text-on-surface sm:text-headline-large">文章专栏</h1>
        <div class="flex flex-wrap gap-2">
            <button type="button" data-topic="all" aria-pressed="true" class="m3-chip">
                <Icon class="m3-chip__icon" name="material-symbols:check-rounded" aria-hidden="true" />全部
            </button>
            {topics.map((topic) => (
                <button type="button" data-topic={topic} aria-pressed="false" class="m3-chip">
                    <Icon class="m3-chip__icon" name="material-symbols:check-rounded" aria-hidden="true" />{topic}
                </button>
            ))}
        </div>
        <div id="topic-summary" class="text-body-medium text-on-surface-variant" role="status" aria-live="polite"></div>
    </header>
    <div class="m3-post-grid">
        {posts.map((post) => (
            <PostCard post={post} showTopic attrs={{ "data-post-topic": post.topic }} />
        ))}
    </div>
    <script>
        import { initPostFilter } from "../../scripts/postFilter";

        initPostFilter({
            buttonAttr: "data-topic",
            cardAttr: "data-post-topic",
            summaryId: "topic-summary",
            noun: "主题",
            matchMode: "equals",
        });
    </script>
</BaseLayout>
