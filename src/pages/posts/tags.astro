---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { Icon } from 'astro-icon/components';
import { posts } from "../../data/posts";

const tags = [...new Set(posts.flatMap((post) => post.tags))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="文章标签" description="按标签浏览 June_qwq 的文章。">
    <header class="flex flex-col gap-4">
        <h1 class="text-headline-medium text-on-surface sm:text-headline-large">文章标签</h1>
        <div class="flex flex-wrap gap-2">
            <button type="button" data-tag="all" aria-pressed="true" class="m3-chip">
                <Icon class="m3-chip__icon" name="material-symbols:check-rounded" aria-hidden="true" />全部
            </button>
            {tags.map((tag) => (
                <button type="button" data-tag={tag} aria-pressed="false" class="m3-chip">
                    <Icon class="m3-chip__icon" name="material-symbols:check-rounded" aria-hidden="true" />{tag}
                </button>
            ))}
        </div>
        <div id="tag-summary" class="text-body-medium text-on-surface-variant" role="status" aria-live="polite"></div>
    </header>
    <div class="m3-post-grid">
        {posts.map((post) => (
            <PostCard post={post} attrs={{ "data-post-tags": post.tags.join(",") }} />
        ))}
    </div>
    <script>
        import { initPostFilter } from "../../scripts/postFilter";

        initPostFilter({
            buttonAttr: "data-tag",
            cardAttr: "data-post-tags",
            summaryId: "tag-summary",
            noun: "标签",
            matchMode: "includes",
        });
    </script>
</BaseLayout>
