---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../assets/PostList.css";
import Card from "../../components/Card.astro";
import PostCard from "../../components/PostCard.astro";
import { posts } from "../../data/posts";

const tags = [...new Set(posts.flatMap((post) => post.tags))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="文章标签" description="按标签浏览 June_qwq 的文章。">
    <Card>
        <h1 class="card-title">文章标签</h1>
        <div class="mb-6 flex flex-wrap gap-2">
            <button
                type="button"
                data-tag="all"
                class="rounded-full border border-white list-btn list-btn-active px-4 py-2 text-sm transition"
            >
                全部
            </button>
            {tags.map((tag) => (
                <button
                    type="button"
                    data-tag={tag}
                    class="rounded-full list-btn border border-base-content/10 px-4 py-2 text-sm transition"
                >
                    {tag}
                </button>
            ))}
        </div>
        <div id="tag-summary" class="mb-4 text-sm opacity-70"></div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {posts.map((post) => (
                <PostCard post={post} attrs={{ "data-post-tags": post.tags.join(",") }} />
            ))}
        </div>
    </Card>
    <script>
        import { initPostFilter } from "../../scripts/postFilter";

        initPostFilter({
            buttonAttr: "data-tag",
            cardAttr: "data-post-tags",
            summaryId: "tag-summary",
            noun: "标签",
            matchMode: "includes",
            hoverClass: "hover:border-white",
        });
    </script>
</BaseLayout>
