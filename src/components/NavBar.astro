---
import { Icon } from "astro-icon/components";

const decode = (segment: string): string => {
    try {
        return decodeURIComponent(segment);
    } catch {
        return segment;
    }
};

const segments = Astro.url.pathname.split("/").filter(Boolean);
const crumbs = segments.map((segment, index) => ({
    label: decode(segment),
    href: `/${segments.slice(0, index + 1).join("/")}/`,
}));
const isHome = crumbs.length === 0;
---

<nav class="m3-breadcrumb" aria-label="面包屑导航">
    <ol class="m3-breadcrumb__list">
        <li>
            {
                isHome ? (
                    <span class="m3-breadcrumb__current" aria-current="page">
                        <Icon name="material-symbols:home-rounded" aria-hidden="true" />
                        June_qwq
                    </span>
                ) : (
                    <a class="m3-icon-button" href="/" aria-label="首页">
                        <Icon name="material-symbols:home-outline-rounded" aria-hidden="true" />
                    </a>
                )
            }
        </li>
        {
            crumbs.map((crumb, index) => (
                <li>
                    <Icon class="m3-breadcrumb__sep" name="material-symbols:chevron-right-rounded" aria-hidden="true" />
                    {index === crumbs.length - 1 ? (
                        <span class="m3-breadcrumb__current" aria-current="page">
                            {crumb.label}
                        </span>
                    ) : (
                        <a class="m3-breadcrumb__link" href={crumb.href}>
                            {crumb.label}
                        </a>
                    )}
                </li>
            ))
        }
    </ol>
</nav>

<script>
    // Long slugs overflow on phones; keep the current page in view.
    const list = document.querySelector<HTMLElement>(".m3-breadcrumb__list");

    if (list) {
        list.scrollLeft = list.scrollWidth;
    }
</script>
