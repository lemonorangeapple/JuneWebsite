---
import { Icon } from "astro-icon/components";
---

<button
    id="theme-toggle"
    type="button"
    class="m3-icon-button"
    aria-label="深色模式"
    aria-pressed="false"
    title="切换主题"
>
    <Icon class="m3-theme-icon--light" name="material-symbols:light-mode-outline-rounded" aria-hidden="true" />
    <Icon class="m3-theme-icon--dark" name="material-symbols:dark-mode-outline-rounded" aria-hidden="true" />
</button>

<script is:inline>
    const storageKey = "theme";
    const button = document.getElementById("theme-toggle");

    const getSavedTheme = () => {
        try {
            const saved = localStorage.getItem(storageKey);
            return saved === "light" || saved === "dark" ? saved : null;
        } catch {
            return null;
        }
    };

    if (button) {
        const root = document.documentElement;
        const preferLight = window.matchMedia("(prefers-color-scheme: light)");

        const applyTheme = (theme) => {
            root.setAttribute("data-theme", theme);
            button.setAttribute("aria-pressed", String(theme === "dark"));
        };

        applyTheme(getSavedTheme() ?? (preferLight.matches ? "light" : "dark"));

        button.addEventListener("click", () => {
            const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
            applyTheme(next);

            try {
                localStorage.setItem(storageKey, next);
            } catch {
                // Storage can be blocked; the choice then only lasts for this page view.
            }
        });

        preferLight.addEventListener("change", (event) => {
            if (!getSavedTheme()) {
                applyTheme(event.matches ? "light" : "dark");
            }
        });
    }
</script>
