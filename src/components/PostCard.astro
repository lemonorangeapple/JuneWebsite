---
import type { Post } from "../data/posts";

interface Props {
    post: Post;
    showTopic?: boolean;
    attrs?: Record<string, string>;
}

const { post, showTopic = false, attrs = {} } = Astro.props;
---

<a href={post.url} {...attrs} class="m3-card m3-card--outlined m3-card--interactive m3-post-card">
    <p class="m3-post-card__meta">
        <time datetime={post.date}>{post.date}</time>
        {showTopic && post.topic && <span> · 主题：{post.topic}</span>}
    </p>
    <h2 class="m3-post-card__title">{post.title}</h2>
    {post.description && <p class="m3-post-card__description">{post.description}</p>}
    {post.tags.length > 0 && (
        <div class="m3-post-card__tags">
            {post.tags.map((tag) => (
                <span class="m3-chip m3-chip--static">{tag}</span>
            ))}
        </div>
    )}
</a>
