---
import type { Post } from "../data/posts";

interface Props {
    post: Post;
    showTopic?: boolean;
    attrs?: Record<string, string>;
}

const { post, showTopic = false, attrs = {} } = Astro.props;
---

<a
    href={post.url}
    {...attrs}
    class="post rounded-xl border border-base-content/10 p-4 transition list-post hover:shadow-md"
>
    <div class="text-sm opacity-70">{post.date}</div>
    <div class="mt-2 text-lg font-semibold">{post.title}</div>
    {showTopic && post.topic && <div class="mt-2 text-xs opacity-70">主题：{post.topic}</div>}
    {post.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
            {post.tags.map((tag) => (
                <span class="rounded-full bg-base-200 px-2 py-1 text-xs">{tag}</span>
            ))}
        </div>
    )}
    {post.description && <p class="mt-2 line-clamp-3 text-sm opacity-75">{post.description}</p>}
</a>
