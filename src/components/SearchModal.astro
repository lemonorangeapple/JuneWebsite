---
import { Icon } from "astro-icon/components";
---

<dialog id="search_modal" class="m3-search-view" aria-labelledby="search_title">
    <h2 id="search_title" class="sr-only">搜索文章</h2>
    <div class="m3-search-view__header">
        <button id="search_close" type="button" class="m3-icon-button" aria-label="关闭搜索">
            <Icon name="material-symbols:arrow-back-rounded" aria-hidden="true" />
        </button>
        <label for="search_input" class="sr-only">搜索文章内容、标签或专栏</label>
        <input
            id="search_input"
            type="search"
            class="m3-search-view__input"
            placeholder="搜索文章内容、标签、专栏等"
            autocomplete="off"
            enterkeyhint="search"
            aria-controls="search_results"
        />
        <button id="search_clear" type="button" class="m3-icon-button" aria-label="清除搜索内容" hidden>
            <Icon name="material-symbols:close-rounded" aria-hidden="true" />
        </button>
    </div>
    <div id="search_div" class="m3-search-view__results">
        <p id="search_status" class="sr-only" aria-live="polite"></p>
        <div id="search_results"></div>
    </div>
    <template id="search_result_icon">
        <Icon name="material-symbols:article-outline-rounded" aria-hidden="true" />
    </template>
</dialog>

<script>
    type SearchPost = {
        title: string;
        url: string;
        description: string;
        topic: string;
        tags: string[];
        content: string;
    };

    const modal = document.getElementById("search_modal");
    const trigger = document.getElementById("search-trigger");
    const input = document.getElementById("search_input");
    const closeButton = document.getElementById("search_close");
    const clearButton = document.getElementById("search_clear");
    const results = document.getElementById("search_results");
    const status = document.getElementById("search_status");
    const iconTemplate = document.getElementById("search_result_icon");

    if (
        modal instanceof HTMLDialogElement &&
        trigger instanceof HTMLButtonElement &&
        input instanceof HTMLInputElement &&
        closeButton instanceof HTMLButtonElement &&
        clearButton instanceof HTMLButtonElement &&
        results instanceof HTMLElement &&
        status instanceof HTMLElement
    ) {
        let postsCache: Promise<SearchPost[]> | null = null;
        let renderVersion = 0;
        let timer: ReturnType<typeof setTimeout> | undefined;

        const loadPosts = (): Promise<SearchPost[]> => {
            postsCache ??= fetch("/search.json")
                .then(async (response) => {
                    if (!response.ok) {
                        throw new Error(`搜索数据加载失败 (${response.status})`);
                    }

                    const data: unknown = await response.json();
                    return Array.isArray(data) ? data as SearchPost[] : [];
                })
                .catch((error) => {
                    postsCache = null;
                    throw error;
                });

            return postsCache;
        };

        const createMessage = (text: string, isError = false): HTMLDivElement => {
            const message = document.createElement("div");
            message.className = isError
                ? "m3-search-view__message m3-search-view__message--error"
                : "m3-search-view__message";
            message.textContent = text;
            return message;
        };

        const createResult = (post: SearchPost): HTMLAnchorElement => {
            const link = document.createElement("a");
            link.href = post.url;
            link.className = "m3-list-item";

            const leading = document.createElement("span");
            leading.className = "m3-list-item__leading";
            leading.setAttribute("aria-hidden", "true");
            if (iconTemplate instanceof HTMLTemplateElement) {
                leading.append(iconTemplate.content.cloneNode(true));
            }

            const body = document.createElement("span");
            body.className = "m3-list-item__body";

            const topic = document.createElement("span");
            topic.className = "text-label-medium text-on-surface-variant";
            topic.textContent = post.topic || "文章";

            const title = document.createElement("span");
            title.className = "text-title-medium";
            title.textContent = post.title;

            body.append(topic, title);

            if (post.description) {
                const description = document.createElement("span");
                description.className = "line-clamp-2 text-body-medium text-on-surface-variant";
                description.textContent = post.description;
                body.append(description);
            }

            link.append(leading, body);
            return link;
        };

        const renderResults = async (query: string): Promise<void> => {
            const version = ++renderVersion;
            status.textContent = "正在加载搜索结果";

            try {
                const posts = await loadPosts();
                if (version !== renderVersion) {
                    return;
                }

                const term = query.trim().toLocaleLowerCase("zh-CN");
                const matched = term
                    ? posts.filter((post) => [
                          post.title,
                          post.description,
                          post.topic,
                          ...post.tags,
                          post.content,
                      ].join(" ").toLocaleLowerCase("zh-CN").includes(term))
                    : posts;

                if (matched.length) {
                    results.replaceChildren(...matched.map(createResult));
                    status.textContent = `找到 ${matched.length} 篇文章`;
                } else {
                    results.replaceChildren(createMessage("无结果"));
                    status.textContent = "没有找到相关文章";
                }
            } catch (error) {
                console.error(error);
                const failure = createMessage("搜索数据加载失败，请稍后重试", true);
                results.replaceChildren(failure);
                status.textContent = failure.textContent;
            }
        };

        const scheduleRender = (): void => {
            clearTimeout(timer);
            timer = setTimeout(() => void renderResults(input.value), 150);
        };

        input.addEventListener("input", () => {
            clearButton.hidden = input.value === "";
            scheduleRender();
        });

        input.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                event.preventDefault();
                modal.close();
            }
        });

        clearButton.addEventListener("click", () => {
            input.value = "";
            clearButton.hidden = true;
            input.focus();
            scheduleRender();
        });

        closeButton.addEventListener("click", () => modal.close());

        // Clicks on the backdrop are dispatched to the dialog itself; clicks inside the view always hit a child.
        modal.addEventListener("click", (event) => {
            if (event.target === modal) {
                modal.close();
            }
        });

        trigger.addEventListener("click", () => {
            modal.showModal();
            input.focus();
            void renderResults("");
        });

        modal.addEventListener("close", () => {
            clearTimeout(timer);
            input.value = "";
            clearButton.hidden = true;
            renderVersion += 1;
            results.replaceChildren();
            status.textContent = "";
            trigger.focus();
        });
    }
</script>
