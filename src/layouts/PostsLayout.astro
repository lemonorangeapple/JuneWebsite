---
import Katex from "../components/Katex.astro";
import Card from "../components/Card.astro";
import Comments from "../components/Comments.astro";
import Placeholder from "../components/Placeholder.astro";
import BaseLayout from "./BaseLayout.astro";
import type { MarkdownLayoutProps } from "astro";

type Props = MarkdownLayoutProps<{
    title: string;
    date: string;
    description: string;
    topic?: string;
    tags: Array<string>;
    math?: boolean;
}>;

const { frontmatter } = Astro.props;
---

<BaseLayout
    title={frontmatter.title}
    description={frontmatter.description}
    type="article"
    publishedTime={frontmatter.date}
>
    {frontmatter.math && <Katex />}
    <article>
        <Card>
            <h1 class="card-title">{frontmatter.title}</h1>
            <time class="post-date" datetime={frontmatter.date}>写于 {frontmatter.date}</time>
            <div class="post-content">
                <slot />
            </div>
        </Card>
    </article>
    <Card>
        <Comments />
    </Card>
    <Placeholder />
    <script>
        document
            .querySelectorAll<HTMLInputElement>('.post-content .task-list-item input[type="checkbox"]')
            .forEach((checkbox) => {
                const label = checkbox.parentElement?.textContent?.trim();
                if (label) {
                    checkbox.setAttribute("aria-label", label);
                }
            });
    </script>
</BaseLayout>
