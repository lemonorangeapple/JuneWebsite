---
import Katex from "../components/Katex.astro";
import Card from "../components/Card.astro";
import Comments from "../components/Comments.astro";
import BaseLayout from "./BaseLayout.astro";
import type { MarkdownLayoutProps } from "astro";

type Props = MarkdownLayoutProps<{
    title: string;
    date: string;
    description: string;
    topic?: string;
    tags: Array<string>;
    math?: boolean;
}>;

const { frontmatter } = Astro.props;
---

<BaseLayout
    title={frontmatter.title}
    description={frontmatter.description}
    type="article"
    publishedTime={frontmatter.date}
>
    {frontmatter.math && <Katex />}
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
        <article>
            <Card>
                <header class="flex flex-col gap-2">
                    <h1 class="text-headline-medium text-on-surface sm:text-headline-large">{frontmatter.title}</h1>
                    <time class="text-label-large text-on-surface-variant" datetime={frontmatter.date}>
                        写于 {frontmatter.date}
                    </time>
                </header>
                <div class="post-content">
                    <slot />
                </div>
            </Card>
        </article>
        <Card variant="outlined">
            <Comments />
        </Card>
    </div>
    <script>
        document
            .querySelectorAll<HTMLInputElement>('.post-content .task-list-item input[type="checkbox"]')
            .forEach((checkbox) => {
                const label = checkbox.parentElement?.textContent?.trim();
                if (label) {
                    checkbox.setAttribute("aria-label", label);
                }
            });
    </script>
</BaseLayout>
